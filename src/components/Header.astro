---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} — Startseite`}>
			<svg
				class="site-mark"
				viewBox="0 0 32 32"
				width="20"
				height="20"
				aria-hidden="true"
			>
				<path
					d="M20 5 L7 27 M14 15 L26 27"
					stroke="currentColor"
					stroke-width="4"
					stroke-linecap="butt"
					fill="none"
				></path>
			</svg>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
